From: Steven Enamakel <enamakel@tinyhumans.ai>
Date: Sun, 11 Oct 2026 21:52:38 +0530
Subject: [PATCH 8/9] test(lock): cover stale lock takeover and live owner
 refusal

Add tests for the ledger lock: one verifies that a lock file left behind by a
process that has exited is taken over by the next acquirer, and the other
confirms acquisition still fails while the recorded owner is alive or the
contents cannot be parsed as a pid.

Auto-committed-on: macbook
Co-authored-by: Medulla <medulla@tinyhumans.ai>
---
 crates/tinyrsi-gateway/src/lock/test.rs | 28 +++++++++++++++++++++++++
 1 file changed, 28 insertions(+)

diff --git a/crates/tinyrsi-gateway/src/lock/test.rs b/crates/tinyrsi-gateway/src/lock/test.rs
index 3b6b478..2724026 100644
--- a/crates/tinyrsi-gateway/src/lock/test.rs
+++ b/crates/tinyrsi-gateway/src/lock/test.rs
@@ -51,3 +51,31 @@ fn reports_a_lock_folder_that_cannot_be_created_or_written() {
         }
     }
 }
+
+#[cfg(unix)]
+#[test]
+fn takes_over_a_lock_left_by_a_process_that_died() {
+    let dir = tempfile::tempdir().unwrap();
+    let ledger = dir.path().join("ledger-total.json");
+    let mut gone = std::process::Command::new("true").spawn().unwrap();
+    let dead_pid = gone.id();
+    gone.wait().unwrap();
+    std::fs::write(dir.path().join("ledger-total.lock"), format!("{dead_pid}\n")).unwrap();
+    let _taken = LedgerLock::acquire(&ledger).unwrap();
+    let held_by = std::fs::read_to_string(dir.path().join("ledger-total.lock")).unwrap();
+    assert_eq!(held_by.trim(), std::process::id().to_string());
+}
+
+#[test]
+fn keeps_refusing_while_the_owner_is_alive_or_unknown() {
+    let dir = tempfile::tempdir().unwrap();
+    let ledger = dir.path().join("ledger-total.json");
+    let lock = dir.path().join("ledger-total.lock");
+    for owner in [format!("{}\n", std::process::id()), "not a pid\n".to_owned()] {
+        std::fs::write(&lock, &owner).unwrap();
+        assert!(matches!(
+            LedgerLock::acquire(&ledger).unwrap_err(),
+            Error::Locked(_)
+        ));
+    }
+}
