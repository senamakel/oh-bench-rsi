+//! Query-aware excerpts: what a long hit keeps, and what it falls back to.
+
+use super::*;
+
+fn page(answer: &str) -> String {
+    let filler: String = (0..30).map(|i| format!("menu item {i}\n")).collect();
+    format!("Visited the settings page.\n{filler}{answer}\n{filler}")
+}
+
+#[test]
+fn short_text_is_returned_whole_on_one_line() {
+    assert_eq!(excerpt("one\ntwo", Some("two"), 100), "one two");
+}
+
+#[test]
+fn keeps_the_lead_and_the_matching_line_in_order() {
+    let text = page("Archive retention: 90 days");
+    let out = excerpt(&text, Some("archive retention"), 200);
+    assert!(out.starts_with("Visited the settings page."), "{out}");
+    assert!(out.contains("Archive retention: 90 days"), "{out}");
+    assert!(out.find("Visited").unwrap() < out.find("Archive").unwrap());
+    assert!(out.chars().count() <= 200, "{}", out.chars().count());
+}
+
+#[test]
+fn marks_skipped_lines() {
+    let out = excerpt(&page("Archive retention: 90 days"), Some("archive"), 200);
+    assert!(out.contains(" … Archive retention"), "{out}");
+    assert!(out.ends_with('…'), "{out}");
+}
+
+#[test]
+fn ranks_lines_by_how_many_query_terms_they_share() {
+    let filler: String = (0..30).map(|i| format!("menu item {i}\n")).collect();
+    let text = format!("Lead line.\n{filler}archive policy\n{filler}archive retention policy\n");
+    let out = excerpt(&text, Some("archive retention policy"), 90);
+    assert!(out.contains("archive retention policy"), "{out}");
+}
+
+#[test]
+fn falls_back_to_the_head_without_a_query_or_a_match() {
+    let text = page("Archive retention: 90 days");
+    assert_eq!(excerpt(&text, None, 60), shorten(&single_line(&text), 60));
+    assert_eq!(
+        excerpt(&text, Some("unrelated words"), 60),
+        shorten(&single_line(&text), 60)
+    );
+    assert_eq!(
+        excerpt(&text, Some("is the"), 60),
+        shorten(&single_line(&text), 60)
+    );
+}
+
+#[test]
+fn shortens_a_single_long_matching_line() {
+    let long = format!("archive {}", "x".repeat(500));
+    let text = format!("{long}\n{}", "filler line\n".repeat(20));
+    let out = excerpt(&text, Some("archive"), 120);
+    assert!(out.starts_with("archive"), "{out}");
+    assert!(out.chars().count() <= 120, "{}", out.chars().count());
+}
+
+#[test]
+fn query_terms_ignore_stopwords_short_words_and_repeats() {
+    assert_eq!(
+        terms("What is the Archive retention, archive?"),
+        ["archive", "retention"]
+    );
+}
