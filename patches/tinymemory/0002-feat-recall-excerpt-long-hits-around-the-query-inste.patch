+//! Query-aware excerpts of long hits.
+//!
+//! A pack shows each hit as one bullet of at most a few hundred characters.
+//! Cutting a long hit to its first characters keeps its preamble and drops
+//! whatever else it holds — for a tool-heavy agent turn or a long document,
+//! usually the very line the question is about. When the pack has a query,
+//! [`excerpt`] instead keeps:
+//!
+//! - a short **lead** (the hit's first lines), so the bullet still says what
+//!   the item is;
+//! - the **lines that share the most query terms**, best first, until the
+//!   budget is spent;
+//!
+//! and shows them in their original order, joined by an ellipsis wherever
+//! lines were skipped. Without a query, or when no line shares a term with
+//! it, the result is the plain head cut [`shorten`] gives.
+
+use std::collections::HashSet;
+
+use super::render::{shorten, single_line};
+
+/// Share of the budget reserved for the lead.
+const LEAD_SHARE: usize = 4;
+
+/// Marks lines skipped between kept ones.
+const GAP: &str = " … ";
+
+/// Words too common to say anything about relevance.
+const STOPWORDS: &[&str] = &[
+    "a", "an", "and", "are", "as", "at", "be", "by", "can", "did", "do", "does", "for", "from",
+    "had", "has", "have", "how", "i", "in", "is", "it", "its", "my", "of", "on", "or", "our",
+    "that", "the", "their", "there", "this", "to", "was", "were", "what", "when", "where", "which",
+    "who", "why", "with", "you", "your",
+];
+
+/// `text` as one line of at most `max_chars` characters, chosen for `query`.
+pub(crate) fn excerpt(text: &str, query: Option<&str>, max_chars: usize) -> String {
+    let flat = single_line(text);
+    if flat.chars().count() <= max_chars {
+        return flat;
+    }
+    let terms = query.map(terms).unwrap_or_default();
+    let lines: Vec<String> = text
+        .lines()
+        .map(single_line)
+        .filter(|line| !line.is_empty())
+        .collect();
+    let scores: Vec<usize> = lines
+        .iter()
+        .map(|line| {
+            let words = terms_of(line);
+            terms.iter().filter(|term| words.contains(*term)).count()
+        })
+        .collect();
+    if terms.is_empty() || scores.iter().all(|&score| score == 0) {
+        return shorten(&flat, max_chars);
+    }
+
+    let mut kept = vec![false; lines.len()];
+    let mut used = 0usize;
+    let cost = |line: &str| line.chars().count() + GAP.chars().count();
+    // The lead: whole first lines while they fit in their share.
+    for (index, line) in lines.iter().enumerate() {
+        if used + cost(line) > max_chars / LEAD_SHARE {
+            break;
+        }
+        kept[index] = true;
+        used += cost(line);
+    }
+    // Then the best-matching lines; ties go to the earlier line.
+    let mut ranked: Vec<usize> = (0..lines.len()).filter(|&i| scores[i] > 0).collect();
+    ranked.sort_by(|&a, &b| scores[b].cmp(&scores[a]).then(a.cmp(&b)));
+    for index in ranked {
+        if kept[index] {
+            continue;
+        }
+        let remaining = max_chars.saturating_sub(used);
+        if cost(&lines[index]) <= remaining {
+            kept[index] = true;
+            used += cost(&lines[index]);
+        } else if !kept.iter().any(|&k| k) || used < max_chars / 2 {
+            // A single long matching line: show its head rather than nothing.
+            let room = remaining.saturating_sub(GAP.chars().count());
+            if room > 20 {
+                let shortened = shorten(&lines[index], room);
+                return join_kept(&lines, &kept, Some((index, shortened)));
+            }
+        }
+    }
+    join_kept(&lines, &kept, None)
+}
+
+/// The kept lines in order, with a gap marker wherever lines were skipped.
+fn join_kept(lines: &[String], kept: &[bool], replaced: Option<(usize, String)>) -> String {
+    let mut out = String::new();
+    let mut skipped = false;
+    for (index, line) in lines.iter().enumerate() {
+        let shown = match &replaced {
+            Some((at, text)) if *at == index => Some(text.as_str()),
+            _ if kept[index] => Some(line.as_str()),
+            _ => None,
+        };
+        match shown {
+            Some(text) => {
+                if !out.is_empty() {
+                    out.push_str(if skipped { GAP } else { " " });
+                } else if skipped {
+                    out.push_str(GAP.trim_start());
+                }
+                out.push_str(text);
+                skipped = false;
+            }
+            None => skipped = true,
+        }
+    }
+    if skipped {
+        out.push_str(GAP.trim_end());
+    }
+    out
+}
+
+/// The distinct, lowercased content words of a query.
+fn terms(query: &str) -> Vec<String> {
+    let mut seen = HashSet::new();
+    words(query)
+        .filter(|word| word.chars().count() >= 3 && !STOPWORDS.contains(&word.as_str()))
+        .filter(|word| seen.insert(word.clone()))
+        .collect()
+}
+
+/// The lowercased words of a line, as a set.
+fn terms_of(line: &str) -> HashSet<String> {
+    words(line).collect()
+}
+
+fn words(text: &str) -> impl Iterator<Item = String> + '_ {
+    text.split(|c: char| !c.is_alphanumeric())
+        .filter(|word| !word.is_empty())
+        .map(str::to_lowercase)
+}
+
+#[cfg(test)]
+#[path = "excerpt_tests.rs"]
+mod tests;
