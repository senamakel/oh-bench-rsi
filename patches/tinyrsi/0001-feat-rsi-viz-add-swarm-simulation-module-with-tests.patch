+import { describe, expect, it } from "vitest";
+import { applySwarmBatch, initialSwarmState, isSwarmLine, TOOL_HISTORY } from "./swarm";
+
+const line = (seq: number, event: Record<string, unknown>) => JSON.stringify({ seq, elapsed_ms: seq * 10, event });
+
+const started = line(0, {
+  kind: "swarm_started",
+  hive: "memory-rsi",
+  desk: "memory-lab",
+  run: "run-02-e1",
+  seats: [
+    { id: "lead", role: "lead", model: "z-ai/glm-5.3-flash", action_dir: "/tm", editing: false },
+    { id: "implementer-a", role: "implementer", model: "z-ai/glm-5.3-flash", action_dir: "/wt", editing: true },
+  ],
+});
+
+describe("swarm fold", () => {
+  it("registers seats in declaration order", () => {
+    const s = applySwarmBatch(initialSwarmState(), started);
+    expect(s.order).toEqual(["lead", "implementer-a"]);
+    expect(s.seats["implementer-a"].editing).toBe(true);
+    expect(s.hive).toBe("memory-rsi");
+  });
+
+  it("counts messages per edge, using private recipients when present", () => {
+    const s = applySwarmBatch(
+      initialSwarmState(),
+      [
+        started,
+        line(1, { kind: "agent_message", sequence: 1, from: "host", to: "hive:memory-lab", body: "brief", only_for: ["lead"] }),
+        line(2, { kind: "agent_message", sequence: 2, from: "lead", to: "implementer-a", body: "do x", only_for: [] }),
+        line(3, { kind: "agent_message", sequence: 3, from: "lead", to: "implementer-a", body: "and y", only_for: [] }),
+      ].join("\n"),
+    );
+    expect(s.edges).toEqual({ "host→lead": 1, "lead→implementer-a": 2 });
+    expect(s.seats.lead.messagesSent).toBe(2);
+    expect(s.messages.map((m) => m.body)).toEqual(["brief", "do x", "and y"]);
+  });
+
+  it("tracks the active tool and failures", () => {
+    let s = applySwarmBatch(initialSwarmState(), started);
+    s = applySwarmBatch(s, line(1, { kind: "tool_call", seat: "implementer-a", tool: "shell", phase: "started", detail: "cargo test" }));
+    expect(s.seats["implementer-a"].activeTool).toBe("shell");
+    s = applySwarmBatch(s, line(2, { kind: "tool_call", seat: "implementer-a", tool: "shell", phase: "completed", success: false }));
+    expect(s.seats["implementer-a"].activeTool).toBeNull();
+    expect(s.seats["implementer-a"].toolFailures).toBe(1);
+    expect(s.seats["implementer-a"].toolCalls).toBe(1);
+  });
+
+  it("accumulates turns and keeps the latest spend", () => {
+    const s = applySwarmBatch(
+      initialSwarmState(),
+      [
+        started,
+        line(1, { kind: "agent_turn", seat: "lead", input_tokens: 100, output_tokens: 20, cost_usd: 0.01 }),
+        line(2, { kind: "agent_turn", seat: "lead", input_tokens: 50, output_tokens: 5, cost_usd: 0.002 }),
+        line(3, { kind: "spend", run_usd: 1.5, run_limit_usd: 5, total_usd: 3, total_limit_usd: 50, by_seat: { lead: 0.012 } }),
+        line(4, { kind: "swarm_finished", reason: "idle", completed: 3, failed: 0 }),
+      ].join("\n"),
+    );
+    expect(s.seats.lead.turns).toBe(2);
+    expect(s.seats.lead.inputTokens).toBe(150);
+    expect(s.seats.lead.costUsd).toBeCloseTo(0.012);
+    expect(s.spend?.runLimitUsd).toBe(5);
+    expect(s.spend?.bySeat.lead).toBeCloseTo(0.012);
+    expect(s.finished?.reason).toBe("idle");
+    expect(s.finished?.detail.completed).toBe(3);
+  });
+
+  it("ignores loop-trace kinds and garbage, and bounds tool history", () => {
+    const loop = line(0, { kind: "epoch_started", epoch: 1, incumbent: "abc" });
+    expect(isSwarmLine(loop)).toBe(false);
+    expect(isSwarmLine(started)).toBe(true);
+    expect(isSwarmLine("not json")).toBe(false);
+    let s = applySwarmBatch(initialSwarmState(), `${loop}\nnot json\n`);
+    expect(s).toEqual(initialSwarmState());
+    const calls = Array.from({ length: TOOL_HISTORY + 5 }, (_, i) =>
+      line(i, { kind: "tool_call", seat: "x", tool: "read", phase: "started" }),
+    );
+    s = applySwarmBatch(s, calls.join("\n"));
+    expect(s.tools).toHaveLength(TOOL_HISTORY);
+  });
+});
