+/**
+ * Swarm traces: the per-seat activity of a tinyhivemind hive of agents.
+ *
+ * A swarm host (for example oh-bench-rsi's `ohrsi-swarm`) writes these kinds
+ * into its own `events.jsonl`, in the same envelope as the loop trace:
+ *
+ * | kind | fields |
+ * |---|---|
+ * | `swarm_started` | `hive, desk, run, seats: [{id, role, model, action_dir, editing}]` |
+ * | `agent_message` | `sequence, from, to, body, only_for, episode` |
+ * | `tool_call` | `seat, tool, phase: "started"\|"completed", detail?, success?, output_chars?` |
+ * | `agent_turn` | `seat, input_tokens, output_tokens, cost_usd` |
+ * | `spend` | `run_usd, run_limit_usd, total_usd, total_limit_usd, by_seat` |
+ * | `swarm_finished` | `reason, completed?, failed?, parked?, error?` |
+ *
+ * Loop-trace kinds are left to the loop reducer; this fold ignores them.
+ */
+
+export const SWARM_KINDS = new Set([
+  "swarm_started",
+  "agent_message",
+  "tool_call",
+  "agent_turn",
+  "spend",
+  "swarm_finished",
+]);
+
+export interface SwarmSeat {
+  id: string;
+  role: string;
+  model: string;
+  editing: boolean;
+  actionDir: string;
+  turns: number;
+  inputTokens: number;
+  outputTokens: number;
+  costUsd: number;
+  toolCalls: number;
+  toolFailures: number;
+  /** Tool currently running, if a `started` has no matching `completed` yet. */
+  activeTool: string | null;
+  messagesSent: number;
+}
+
+export interface SwarmMessage {
+  seq: number;
+  sequence: number;
+  from: string;
+  to: string;
+  body: string;
+  onlyFor: string[];
+}
+
+export interface SwarmToolEvent {
+  seq: number;
+  seat: string;
+  tool: string;
+  phase: "started" | "completed";
+  detail: string | null;
+  success: boolean | null;
+}
+
+export interface SwarmSpend {
+  runUsd: number;
+  runLimitUsd: number | null;
+  totalUsd: number;
+  totalLimitUsd: number | null;
+  bySeat: Record<string, number>;
+}
+
+export interface SwarmState {
+  hive: string | null;
+  desk: string | null;
+  run: string | null;
+  order: string[];
+  seats: Record<string, SwarmSeat>;
+  messages: SwarmMessage[];
+  tools: SwarmToolEvent[];
+  /** `from → to` message counts, for the interaction graph. */
+  edges: Record<string, number>;
+  spend: SwarmSpend | null;
+  finished: { reason: string; detail: Record<string, unknown> } | null;
+  elapsedMs: number;
+}
+
+/** Most tool events kept in memory; older ones are dropped. */
+export const TOOL_HISTORY = 200;
+
+export function initialSwarmState(): SwarmState {
+  return {
+    hive: null,
+    desk: null,
+    run: null,
+    order: [],
+    seats: {},
+    messages: [],
+    tools: [],
+    edges: {},
+    spend: null,
+    finished: null,
+    elapsedMs: 0,
+  };
+}
+
+const str = (v: unknown, fallback = ""): string => (typeof v === "string" ? v : fallback);
+const num = (v: unknown, fallback = 0): number => (typeof v === "number" && Number.isFinite(v) ? v : fallback);
+
+function seat(state: SwarmState, id: string): SwarmSeat {
+  return (
+    state.seats[id] ?? {
+      id,
+      role: "",
+      model: "",
+      editing: false,
+      actionDir: "",
+      turns: 0,
+      inputTokens: 0,
+      outputTokens: 0,
+      costUsd: 0,
+      toolCalls: 0,
+      toolFailures: 0,
+      activeTool: null,
+      messagesSent: 0,
+    }
+  );
+}
+
+function withSeat(state: SwarmState, next: SwarmSeat): SwarmState {
+  const order = state.order.includes(next.id) ? state.order : [...state.order, next.id];
+  return { ...state, order, seats: { ...state.seats, [next.id]: next } };
+}
+
+/** Whether one envelope line belongs to the swarm trace. */
+export function isSwarmLine(line: string): boolean {
+  try {
+    const parsed = JSON.parse(line) as { event?: { kind?: unknown } };
+    return typeof parsed.event?.kind === "string" && SWARM_KINDS.has(parsed.event.kind);
+  } catch {
+    return false;
+  }
+}
+
+/** Folds one envelope line; lines of other kinds return `state` unchanged. */
+export function applySwarmLine(state: SwarmState, line: string): SwarmState {
+  let envelope: { seq?: unknown; elapsed_ms?: unknown; event?: Record<string, unknown> };
+  try {
+    envelope = JSON.parse(line);
+  } catch {
+    return state;
+  }
+  const event = envelope.event;
+  if (!event || typeof event.kind !== "string" || !SWARM_KINDS.has(event.kind)) return state;
+  const seq = num(envelope.seq);
+  let next: SwarmState = { ...state, elapsedMs: Math.max(state.elapsedMs, num(envelope.elapsed_ms)) };
+  switch (event.kind) {
+    case "swarm_started": {
+      next = { ...next, hive: str(event.hive), desk: str(event.desk), run: str(event.run) || null };
+      const seats = Array.isArray(event.seats) ? (event.seats as Record<string, unknown>[]) : [];
+      for (const s of seats) {
+        const id = str(s.id);
+        if (!id) continue;
+        next = withSeat(next, {
+          ...seat(next, id),
+          role: str(s.role),
+          model: str(s.model),
+          editing: s.editing === true,
+          actionDir: str(s.action_dir),
+        });
+      }
+      return next;
+    }
+    case "agent_message": {
+      const from = str(event.from, "host");
+      const to = str(event.to);
+      const message: SwarmMessage = {
+        seq,
+        sequence: num(event.sequence),
+        from,
+        to,
+        body: str(event.body),
+        onlyFor: Array.isArray(event.only_for) ? event.only_for.filter((v): v is string => typeof v === "string") : [],
+      };
+      const targets = message.onlyFor.length > 0 ? message.onlyFor : [to];
+      const edges = { ...next.edges };
+      for (const target of targets) {
+        const key = `${from}→${target}`;
+        edges[key] = (edges[key] ?? 0) + 1;
+      }
+      next = { ...next, messages: [...next.messages, message], edges };
+      if (next.seats[from]) next = withSeat(next, { ...next.seats[from], messagesSent: next.seats[from].messagesSent + 1 });
+      return next;
+    }
+    case "tool_call": {
+      const id = str(event.seat);
+      const phase = event.phase === "completed" ? "completed" : "started";
+      const tool: SwarmToolEvent = {
+        seq,
+        seat: id,
+        tool: str(event.tool),
+        phase,
+        detail: typeof event.detail === "string" ? event.detail : null,
+        success: typeof event.success === "boolean" ? event.success : null,
+      };
+      const current = seat(next, id);
+      const updated =
+        phase === "started"
+          ? { ...current, toolCalls: current.toolCalls + 1, activeTool: tool.tool }
+          : { ...current, activeTool: null, toolFailures: current.toolFailures + (tool.success === false ? 1 : 0) };
+      next = withSeat(next, updated);
+      return { ...next, tools: [...next.tools, tool].slice(-TOOL_HISTORY) };
+    }
+    case "agent_turn": {
+      const id = str(event.seat);
+      const current = seat(next, id);
+      return withSeat(next, {
+        ...current,
+        turns: current.turns + 1,
+        inputTokens: current.inputTokens + num(event.input_tokens),
+        outputTokens: current.outputTokens + num(event.output_tokens),
+        costUsd: current.costUsd + num(event.cost_usd),
+        activeTool: null,
+      });
+    }
+    case "spend": {
+      const bySeat: Record<string, number> = {};
+      if (event.by_seat && typeof event.by_seat === "object") {
+        for (const [k, v] of Object.entries(event.by_seat as Record<string, unknown>)) bySeat[k] = num(v);
+      }
+      return {
+        ...next,
+        spend: {
+          runUsd: num(event.run_usd),
+          runLimitUsd: typeof event.run_limit_usd === "number" ? event.run_limit_usd : null,
+          totalUsd: num(event.total_usd),
+          totalLimitUsd: typeof event.total_limit_usd === "number" ? event.total_limit_usd : null,
+          bySeat,
+        },
+      };
+    }
+    case "swarm_finished": {
+      const { kind: _kind, reason, ...detail } = event;
+      return { ...next, finished: { reason: str(reason, "unknown"), detail } };
+    }
+    default:
+      return next;
+  }
+}
+
+/** Folds a whole SSE batch (lines joined by `\n`). */
+export function applySwarmBatch(state: SwarmState, data: string): SwarmState {
+  let next = state;
+  for (const line of data.split("\n")) {
+    if (line.trim() !== "") next = applySwarmLine(next, line);
+  }
+  return next;
+}
