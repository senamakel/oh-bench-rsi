+/**
+ * One swarm at work: who is on the desk, who is talking to whom, what each
+ * seat is doing right now, and what it is costing against the run's caps.
+ */
+
+import { formatDuration } from "@/lib/format";
+import type { SwarmSeat, SwarmState } from "@/lib/swarm";
+
+const usd = (v: number) => `$${v.toFixed(v < 1 ? 4 : 2)}`;
+const tokens = (v: number) => (v >= 1000 ? `${(v / 1000).toFixed(1)}k` : String(v));
+
+function Gauge({ label, value, limit }: { label: string; value: number; limit: number | null }) {
+  const pct = limit ? Math.min(100, (value / limit) * 100) : 0;
+  const tone = pct > 90 ? "var(--reject)" : pct > 70 ? "var(--inconclusive)" : "var(--series)";
+  return (
+    <div style={{ minWidth: 200, flex: 1 }}>
+      <div className="secondary" style={{ display: "flex", justifyContent: "space-between", fontSize: 13 }}>
+        <span>{label}</span>
+        <span className="mono">
+          {usd(value)}
+          {limit !== null ? ` / ${usd(limit)}` : ""}
+        </span>
+      </div>
+      <div style={{ height: 8, borderRadius: 4, background: "var(--grid)", overflow: "hidden", marginTop: 4 }}>
+        <div style={{ width: `${pct}%`, height: "100%", background: tone }} />
+      </div>
+    </div>
+  );
+}
+
+function SeatCard({ seat, spend }: { seat: SwarmSeat; spend: number | undefined }) {
+  return (
+    <div className="card" style={{ padding: 12, borderColor: seat.activeTool ? "var(--series)" : undefined }}>
+      <div style={{ display: "flex", gap: 8, alignItems: "center", flexWrap: "wrap" }}>
+        <strong className="mono">@{seat.id}</strong>
+        <span className="badge">{seat.role || "seat"}</span>
+        {seat.editing ? <span className="badge accept">editing</span> : <span className="badge">read-only</span>}
+        {seat.activeTool ? <span className="badge live">{seat.activeTool}</span> : null}
+      </div>
+      <dl className="facts" style={{ marginTop: 8 }}>
+        <div>
+          <dt>Turns</dt>
+          <dd>{seat.turns}</dd>
+        </div>
+        <div>
+          <dt>Tools</dt>
+          <dd>
+            {seat.toolCalls}
+            {seat.toolFailures ? <span className="muted"> ({seat.toolFailures} failed)</span> : null}
+          </dd>
+        </div>
+        <div>
+          <dt>Tokens</dt>
+          <dd className="mono">
+            {tokens(seat.inputTokens)} in · {tokens(seat.outputTokens)} out
+          </dd>
+        </div>
+        <div>
+          <dt>Spend</dt>
+          <dd className="mono">{usd(spend ?? seat.costUsd)}</dd>
+        </div>
+      </dl>
+      <p className="muted mono" style={{ margin: "6px 0 0", fontSize: 11, overflowWrap: "anywhere" }}>
+        {seat.model} · {seat.actionDir}
+      </p>
+    </div>
+  );
+}
+
+/** Seats on a circle (the host at the centre), edges weighted by message count. */
+function InteractionGraph({ state }: { state: SwarmState }) {
+  const size = 320;
+  const c = size / 2;
+  const r = size / 2 - 50;
+  const pos: Record<string, { x: number; y: number }> = { host: { x: c, y: c } };
+  state.order.forEach((id, i) => {
+    const a = (2 * Math.PI * i) / Math.max(state.order.length, 1) - Math.PI / 2;
+    pos[id] = { x: c + r * Math.cos(a), y: c + r * Math.sin(a) };
+  });
+  const max = Math.max(1, ...Object.values(state.edges));
+  return (
+    <svg viewBox={`0 0 ${size} ${size}`} role="img" aria-label="Messages between seats" style={{ width: "100%", maxWidth: 360 }}>
+      <defs>
+        <marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
+          <path d="M0,0 L10,5 L0,10 z" fill="var(--ink-2)" />
+        </marker>
+      </defs>
+      {Object.entries(state.edges).map(([key, count]) => {
+        const [from, to] = key.split("→");
+        const a = pos[from];
+        const b = pos[to];
+        if (!a || !b || from === to) return null;
+        const dx = b.x - a.x;
+        const dy = b.y - a.y;
+        const len = Math.hypot(dx, dy) || 1;
+        const pad = 26;
+        return (
+          <g key={key}>
+            <line
+              x1={a.x + (dx / len) * pad}
+              y1={a.y + (dy / len) * pad}
+              x2={b.x - (dx / len) * pad}
+              y2={b.y - (dy / len) * pad}
+              stroke="var(--ink-2)"
+              strokeOpacity={0.35 + 0.65 * (count / max)}
+              strokeWidth={1 + 3 * (count / max)}
+              markerEnd="url(#arrow)"
+            />
+            <text x={(a.x + b.x) / 2} y={(a.y + b.y) / 2 - 4} fontSize="10" fill="var(--muted)" textAnchor="middle">
+              {count}
+            </text>
+          </g>
+        );
+      })}
+      {Object.entries(pos).map(([id, p]) => {
+        const seat = state.seats[id];
+        const fill = id === "host" ? "var(--grid)" : seat?.activeTool ? "var(--series)" : "var(--surface)";
+        return (
+          <g key={id}>
+            <circle cx={p.x} cy={p.y} r={22} fill={fill} stroke="var(--axis)" />
+            <text x={p.x} y={p.y + 36} fontSize="11" fill="var(--ink)" textAnchor="middle" className="mono">
+              {id}
+            </text>
+          </g>
+        );
+      })}
+    </svg>
+  );
+}
+
+export function SwarmView({ state }: { state: SwarmState }) {
+  const spend = state.spend;
+  const recentTools = [...state.tools].reverse().slice(0, 40);
+  return (
+    <div className="stack">
+      <section>
+        <div style={{ display: "flex", flexWrap: "wrap", gap: "4px 12px", alignItems: "center" }}>
+          <h1 className="mono">{state.run ?? state.hive ?? "swarm"}</h1>
+          <span className={`badge${state.finished ? "" : " live"}`}>
+            {state.finished ? `finished · ${state.finished.reason}` : "swarm running"}
+          </span>
+        </div>
+        <p className="secondary" style={{ margin: 0 }}>
+          hive <code>{state.hive}</code> · desk <code>{state.desk}</code> · {state.order.length} seats ·{" "}
+          {state.messages.length} messages · {formatDuration(state.elapsedMs)}
+        </p>
+      </section>
+
+      {spend ? (
+        <section className="card" style={{ display: "flex", gap: 24, flexWrap: "wrap" }}>
+          <Gauge label="Run budget" value={spend.runUsd} limit={spend.runLimitUsd} />
+          <Gauge label="Campaign budget" value={spend.totalUsd} limit={spend.totalLimitUsd} />
+        </section>
+      ) : null}
+
+      <div className="grid two">
+        <section className="card">
+          <h2>Who talks to whom</h2>
+          <InteractionGraph state={state} />
+        </section>
+        <section className="stack">
+          {state.order.map((id) => (
+            <SeatCard key={id} seat={state.seats[id]} spend={spend?.bySeat[id]} />
+          ))}
+        </section>
+      </div>
+
+      <section className="card">
+        <h2>Desk transcript</h2>
+        {state.messages.length === 0 ? (
+          <p className="notice">No messages yet.</p>
+        ) : (
+          <ol className="feed">
+            {[...state.messages].reverse().map((m) => (
+              <li key={m.seq}>
+                <div className="head">
+                  <span className="mono">@{m.from}</span>
+                  <span className="muted">→ {m.onlyFor.length ? m.onlyFor.map((t) => `@${t}`).join(", ") : m.to}</span>
+                  <span className="muted mono">#{m.sequence}</span>
+                </div>
+                <pre style={{ whiteSpace: "pre-wrap", margin: "6px 0 0", fontSize: 12, maxHeight: 260, overflow: "auto" }}>
+                  {m.body}
+                </pre>
+              </li>
+            ))}
+          </ol>
+        )}
+      </section>
+
+      <section className="card">
+        <h2>Tool calls</h2>
+        {recentTools.length === 0 ? (
+          <p className="notice">No tool calls yet.</p>
+        ) : (
+          <ol className="feed">
+            {recentTools.map((t) => (
+              <li key={t.seq} className={t.success === false ? "reject" : undefined}>
+                <div className="head">
+                  <span className="mono">@{t.seat}</span>
+                  <span className="mono">{t.tool}</span>
+                  <span className="muted">{t.phase === "started" ? "started" : t.success === false ? "failed" : "done"}</span>
+                </div>
+                {t.detail ? (
+                  <p className="muted mono" style={{ margin: "4px 0 0", fontSize: 11, overflowWrap: "anywhere" }}>
+                    {t.detail}
+                  </p>
+                ) : null}
+              </li>
+            ))}
+          </ol>
+        )}
+      </section>
+    </div>
+  );
+}
