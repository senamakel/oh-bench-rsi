+describe("host naming", () => {
+  it("maps the coordinator's host id onto the graph's host node and drops self edges", () => {
+    const s = applySwarmBatch(
+      initialSwarmState(),
+      [
+        started,
+        line(1, { kind: "agent_message", sequence: 0, from: "hivemind:host", to: "lead", body: "brief", only_for: [] }),
+        line(2, { kind: "agent_message", sequence: 1, from: "lead", to: "hive:x", body: "done", only_for: ["lead", "hivemind:host"] }),
+      ].join("\n"),
+    );
+    expect(s.edges).toEqual({ "host→lead": 1, "lead→host": 1 });
+  });
+});
