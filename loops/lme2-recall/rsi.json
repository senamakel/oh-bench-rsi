{
  "$schema": "https://tinyhumans.ai/schemas/rsi/v1",
  "version": 1,
  "name": "lme2-recall",
  "subject": {
    "kind": "git",
    "path": "../../vendor/openhuman/vendor/tinymemory",
    "branch": "rsi/main",
    "editable": ["crates/tinymemory-tools/", "crates/tinymemory-integrations/"],
    "frozen": ["crates/tinymemory-api/"],
    "require_test_change": true
  },
  "brief": "brief.md",
  "hive": { "package": "hive", "lead": "lead", "wall_secs": 3600, "turn_secs": 1200 },
  "models": { "default": "flash" },
  "keys": { "openrouter": "LADDER_API_KEY", "embeddings": "OPENROUTER_API_KEY" },
  "score": {
    "scorers": [ { "id": "lme2", "run": "python3 -I scorers/lme2.py", "timeout_secs": 14400 } ],
    "decide": { "on": "lme2", "test": "sign", "split": "test", "alpha": 0.10 }
  },
  "gate": [
    { "run": "python3 -I gates/leakage.py" },
    { "run": "python3 -I gates/green.py", "timeout_secs": 3600 }
  ],
  "budget": {
    "run_usd": 5, "total_usd": 50, "score_reserve_usd": 0.6,
    "prices": { "flash": { "prompt_per_mtok": 0.30, "completion_per_mtok": 1.00, "provider": "*" } }
  },
  "epochs": 2,
  "patience": 2,
  "env": {
    "LME2_MODEL": "flash",
    "LME2_EMBEDDING_URL": "https://openrouter.ai/api/v1",
    "LME2_EMBEDDING_KEY_ENV": "OPENROUTER_API_KEY",
    "LME2_REPEATS": "3"
  }
}
