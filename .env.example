# Copy this file to `.env` and fill in real values. `.env` is git-ignored and
# must never be committed.

# OpenRouter key for the benchmark gateway and the RSI proposer. Paid calls are
# capped per campaign by `budget.usd_cap`.
# OPENROUTER_API_KEY=replace-me

# Optional proposer model for the improvement loop.
# OPENROUTER_MODEL=openai/gpt-4.1-mini

# Optional Langfuse export of loop traces (tinyrsi-langfuse).
# LANGFUSE_PUBLIC_KEY=replace-me
# LANGFUSE_SECRET_KEY=replace-me
# LANGFUSE_HOST=https://cloud.langfuse.com

# RUST_LOG=info
