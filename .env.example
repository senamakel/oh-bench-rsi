# Copy this file to `.env` and fill in real values. `.env` is git-ignored and
# must never be committed.

# OpenRouter key: CortexDB's embeddings only (`keys.embeddings`, passed to the
# scorer). Chat calls go through the tinyrsi spend gateway to the ladder,
# capped by `budget.run_usd` / `budget.total_usd` in
# loops/lme2-recall/rsi.json. `tinyrsi` also reads loops/lme2-recall/.env.
# OPENROUTER_API_KEY=replace-me

# Key for the local LLM ladder router (127.0.0.1:6969): the spend gateway's
# upstream key when runs start with TINYRSI_UPSTREAM pointed at the ladder.
# LADDER_API_KEY=replace-me

# Optional Langfuse export of loop traces (tinyrsi-langfuse).
# LANGFUSE_PUBLIC_KEY=replace-me
# LANGFUSE_SECRET_KEY=replace-me
# LANGFUSE_HOST=https://cloud.langfuse.com

# Where tinyrsi stores runs (default ~/.tinyrsi).
# TINYRSI_HOME=~/.tinyrsi

# RUST_LOG=info
